APP_NAME=MedGuard AI
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://medguard:medguard@db:5432/medguard
STORAGE_DIR=/app/storage/uploads
MAX_UPLOAD_MB=25
VIDEO_SAMPLE_EVERY_N_FRAMES=3
VIDEO_LOW_MOTION_THRESHOLD=0.35
VIDEO_ABRUPT_MOTION_THRESHOLD=20.0
VIDEO_MAX_FRAMES=900
CORS_ORIGINS=http://localhost:8501

POSTGRES_DB=medguard
POSTGRES_USER=medguard
POSTGRES_PASSWORD=medguard

API_BASE_URL=http://api:8000

# Reservado para a Etapa 3. Nao inclua segredos reais no repositorio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

