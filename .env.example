APP_NAME=MedGuard AI
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://medguard:medguard@db:5432/medguard
STORAGE_DIR=/app/storage/uploads
MAX_UPLOAD_MB=25
VIDEO_SAMPLE_EVERY_N_FRAMES=3
VIDEO_LOW_MOTION_THRESHOLD=0.35
VIDEO_ABRUPT_MOTION_THRESHOLD=20.0
VIDEO_MAX_FRAMES=900
CORS_ORIGINS=http://localhost:8501

POSTGRES_DB=medguard
POSTGRES_USER=medguard
POSTGRES_PASSWORD=medguard

API_BASE_URL=http://api:8000

# Azure Speech transcreve o WAV. Preencha a chave e a região do recurso Speech.
# Configure credenciais apenas no .env local, ignorado pelo Git.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure AI Language classifica o sentimento e extrai menções a sintomas e sinais.
# Use o endpoint HTTPS e a chave de um recurso com Text Analytics for Health.
# Sem esses valores, as duas análises Azure ficam indisponíveis.
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

